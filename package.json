{
  "name": "csm",
  "productName": "CSM",
  "version": "1.1.0",
  "private": true,
  "description": "CSM（Config Sync Manager）：Google Sheets 配置表与本地 xlsx 同步工具（浏览器 / 桌面 App）",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist:mac": "electron-builder --mac",
    "test": "node --test 'test/**/*.test.js'",
    "release:manifest": "node scripts/make-update-manifest.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "open": "^8.4.2"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "author": "DragonPlus",
  "csm": {
    "updateUrl": ""
  },
  "build": {
    "appId": "com.dragonplus.csm",
    "productName": "CSM",
    "copyright": "DragonPlus",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "lib/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "!lib/.gitkeep"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "credentials.json"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "artifactName": "CSM-${version}-mac-${arch}.${ext}"
    },
    "electronLanguages": [
      "zh_CN",
      "en"
    ]
  }
}
